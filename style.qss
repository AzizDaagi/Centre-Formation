


QMainWindow, QWidget#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #dbece5, stop:0.5 #e2eaf0, stop:1 #d8dbf0);
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #1a2b27;
}




QFrame#sidebar {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 20px;
}

QFrame#glassCard {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
}




QFrame#sidebar QPushButton {
    background-color: transparent;
    color: #475569;
    font-weight: 600;
    font-size: 14px;
    border: none;
    border-radius: 12px;
    padding: 12px 16px;
    text-align: left;
    outline: none;
}

QFrame#sidebar QPushButton:focus {
    outline: none;
    border: none;
}

QFrame#sidebar QPushButton:hover {
    background-color: rgba(15, 118, 110, 0.08);
    color: #0f766e;
}

QFrame#sidebar QPushButton:checked,
QFrame#sidebar QPushButton:checked:focus {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0d9488, stop:1 #14b8a6);
    color: #ffffff;
    font-weight: bold;
    border: none;
    outline: none;
}




QTableWidget {
    background-color: rgba(255, 255, 255, 0.55);
    alternate-background-color: rgba(241, 245, 249, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 14px;
    gridline-color: transparent;
    color: #0f172a;
    font-size: 13px;
    outline: none;
}

QHeaderView::section {
    background-color: transparent;
    color: #64748b;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    border: none;
    border-bottom: 2px solid #e2e8f0;
    padding: 10px;
}

QTableWidget QTableCornerButton::section {
    background-color: transparent;
    border: none;
}

QHeaderView {
    background-color: transparent;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
    color: #1e293b;
    outline: none;
}

QTableWidget::item:hover {
    background-color: rgba(20, 184, 166, 0.08);
}

QTableWidget::item:selected,
QTableWidget::item:selected:active,
QTableWidget::item:selected:!active {
    background-color: #0d9488;
    color: #ffffff;
    font-weight: bold;
}




QLabel {
    color: #1e293b;
    font-weight: 600;
    font-size: 13px;
}

QTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px;
}

QTextEdit:focus {
    border: 2px solid #0d9488;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 12px;
    color: #0f172a;
    font-size: 13px;
}

QLineEdit, QComboBox {
    min-width: 180px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QDateEdit::up-button,
QDateEdit::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    width: 0;
    height: 0;
    border: none;
}

QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    min-width: 110px;
}

QToolButton {
    background: transparent;
    border: none;
    padding: 5px;
    color: #334155;
}

QToolButton:hover {
    background: #e2e8f0;
    border-radius: 6px;
}

QToolButton:disabled {
    background: transparent;
    color: #94a3b8;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #0d9488;
    background-color: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #0d9488;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #ffffff;
    color: #0f172a;
    padding: 8px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #ccfbf1;
    color: #0f172a;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0d9488;
    color: #ffffff;
}




QPushButton#primaryBtn,
QPushButton#btnAjouter,
QPushButton#btnModifier {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0d9488, stop:1 #14b8a6);
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    outline: none;
}

QPushButton#primaryBtn:hover,
QPushButton#btnAjouter:hover,
QPushButton#btnModifier:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0f766e, stop:1 #0d9488);
}

QPushButton#btnSupprimer {
    background-color: #f43f5e;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    outline: none;
}

QPushButton#btnSupprimer:hover {
    background-color: #e11d48;
}

QPushButton#btnVider {
    background-color: rgba(255, 255, 255, 0.8);
    color: #334155;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 20px;
    outline: none;
}

QPushButton#btnVider:hover {
    background-color: #ffffff;
}

QPushButton#primaryBtn:disabled,
QPushButton#btnAjouter:disabled,
QPushButton#btnModifier:disabled,
QPushButton#btnSupprimer:disabled,
QPushButton:disabled {
    background-color: rgba(148, 163, 184, 0.18);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}





QDialog, QMessageBox, QFileDialog {
    background-color: #ffffff;
    color: #0f172a;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMessageBox QLabel, QDialog QLabel {
    background-color: transparent;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
}

QMessageBox QPushButton, QDialog QPushButton {
    background: #0284c7;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 75px;
    outline: none;
}

QMessageBox QPushButton:hover, QDialog QPushButton:hover {
    background: #0369a1;
}

QMessageBox QPushButton:pressed, QDialog QPushButton:pressed {
    background: #075985;
}

QMessageBox QPushButton#qt_msgbox_button_cancel,
QMessageBox QPushButton:disabled {
    background-color: #e2e8f0;
    color: #475569;
}
